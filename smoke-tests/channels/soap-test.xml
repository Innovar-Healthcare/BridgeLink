          <name>Extract patient name</name>
          <sequenceNumber>0</sequenceNumber>
          <enabled>true</enabled>
          <script><![CDATA[channelMap.put('patientName', msg['PID']['PID.5']['PID.5.1'].toString());
// SOAP envelope note (Rule 1 fix, plan 18-07): the destination's <envelope> template embeds
// this value inside an XML element (<payload>...</payload>) — raw HL7 content contains an
// unescaped '&' (MSH-2's own encoding-characters field, '^~\&'), which breaks XML parsing
// exactly like the doc-writer fixture's original bug (see 18-05 SUMMARY Deviation 2). Compute
// an HTML/XML-safe copy the same way.
var rawContent = String(connectorMessage.getRawData());
var soapSafeContent = rawContent.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
channelMap.put('soapSafeContent', soapSafeContent);]]></script>
        </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
