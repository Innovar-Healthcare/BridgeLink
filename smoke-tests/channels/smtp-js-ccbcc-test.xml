          <validateResponse>false</validateResponse>
          <resourceIds class="linked-hash-map">
            <entry>
              <string>Default Resource</string>
              <string>[Default Resource]</string>
            </entry>
          </resourceIds>
          <queueBufferSize>1000</queueBufferSize>
          <reattachAttachments>true</reattachAttachments>
        </destinationConnectorProperties>
        <script><![CDATA[// NET-10 / SC-3 (18.5-05, PR-#177-GATED). SMTPConnectionFactory/SMTPConnection are
// auto-imported into every deployed-script scope from com.mirth.connect.server.userutil
// (JavaScriptBuilder prepends importPackage(Packages.com.mirth.connect.server.userutil)),
// so no explicit import is needed here. createSMTPConnection() builds a real
// ServerSMTPConnection from the server's configured default SMTP settings (in-server,
// ControllerFactory-backed -- OQ-2) -- setHost/setPort below override it to point at this
// harness's dedicated SmtpStub (SMTP_JS_PORT), never the shared server default.
var connection = SMTPConnectionFactory.createSMTPConnection();
connection.setHost('127.0.0.1');
connection.setPort('${SMTP_JS_PORT}');

var to = 'to@to.smoke.test';
var cc = 'cc@cc.smoke.test';
var bcc = 'bcc@bcc.smoke.test';
var from = 'from@from.smoke.test';
var selector = channelMap.get('patientName');
var body = 'Patient: ' + selector;

if (selector == 'JsApi7Arg') {
    // D1: the NEW 7-arg send(to,cc,bcc,from,subject,body,charset) PR #177 adds. This call
    // lives ONLY in this Rhino script string -- never in compiled Java anywhere in
    // smoke-tests (Pitfall 1) -- so the smoke-tests build compiles on the current branch
    // even though this overload does not exist yet. Rhino resolves the overload at
    // INVOCATION time, and this branch is only ever reached once
    // SmtpJsApiCcBccTest's @BeforeClass Assume gate lets PR177_PRESENT=true through and
    // pumps a JsApi7Arg-selector message -- never while the gate is closed.
    connection.send(to, cc, bcc, from, 'Smoke test JS API 7-arg (D1)', body, 'UTF-8');
} else if (selector == 'JsApi6Arg') {
    // D2: pre-existing legacy 6-arg send(to,cc,from,subject,body,charset) -- must keep
    // delivering unchanged (delegates with null bcc internally).
    connection.send(to, cc, from, 'Smoke test JS API 6-arg back-compat (D2)', body, 'UTF-8');
} else {
    // D3: pre-existing legacy 5-arg send(to,cc,from,subject,body) -- must keep delivering
    // unchanged.
    connection.send(to, cc, from, 'Smoke test JS API 5-arg back-compat (D3)', body);
}]]></script>
