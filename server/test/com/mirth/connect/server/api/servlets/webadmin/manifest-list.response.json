{
  "entries": [
    {
      "name": "Mock SMTP Connector",
      "path": "mock-smtp",
      "version": "1.0.0",
      "manifest": {
        "manifestVersion": 1,
        "minWebAdminVersion": "26.3.0",
        "connectorPanels": [
          {
            "mode": "destination",
            "transportName": "Mock SMTP Sender",
            "sections": [
              {
                "title": "SMTP Connection",
                "fields": [
                  {
                    "key": "smtpHost",
                    "type": "text",
                    "label": "SMTP Host",
                    "tooltip": "Hostname or IP address of the SMTP server.",
                    "validation": [
                      {
                        "rule": "required"
                      }
                    ]
                  },
                  {
                    "key": "smtpPort",
                    "type": "number",
                    "label": "SMTP Port",
                    "validation": [
                      {
                        "rule": "required"
                      },
                      {
                        "rule": "min",
                        "value": 1
                      },
                      {
                        "rule": "max",
                        "value": 65535
                      }
                    ]
                  },
                  {
                    "key": "encryption",
                    "type": "select",
                    "label": "Encryption",
                    "options": [
                      {
                        "value": "none",
                        "label": "None"
                      },
                      {
                        "value": "TLS",
                        "label": "STARTTLS"
                      },
                      {
                        "value": "SSL",
                        "label": "SSL"
                      }
                    ]
                  },
                  {
                    "key": "timeout",
                    "type": "number",
                    "label": "Send Timeout (ms)",
                    "validation": [
                      {
                        "rule": "min",
                        "value": 0
                      }
                    ]
                  }
                ]
              },
              {
                "title": "Authentication",
                "fields": [
                  {
                    "key": "authentication",
                    "type": "checkbox",
                    "label": "Use Authentication"
                  },
                  {
                    "key": "username",
                    "type": "text",
                    "label": "Username",
                    "visibleWhen": {
                      "field": "authentication",
                      "op": "truthy"
                    },
                    "validation": [
                      {
                        "rule": "required"
                      }
                    ]
                  },
                  {
                    "key": "password",
                    "type": "secret",
                    "label": "Password",
                    "visibleWhen": {
                      "field": "authentication",
                      "op": "truthy"
                    }
                  }
                ]
              },
              {
                "title": "Message",
                "fields": [
                  {
                    "key": "to",
                    "type": "text",
                    "label": "To Address",
                    "placeholder": "recipient@example.com"
                  },
                  {
                    "key": "from",
                    "type": "text",
                    "label": "From Address",
                    "placeholder": "sender@example.com",
                    "validation": [
                      {
                        "rule": "pattern",
                        "pattern": "^[^@\\s]+@[^@\\s]+$",
                        "message": "From Address must be a valid email address."
                      }
                    ]
                  },
                  {
                    "key": "subject",
                    "type": "text",
                    "label": "Subject"
                  },
                  {
                    "key": "html",
                    "type": "radio",
                    "label": "Body Format",
                    "options": [
                      {
                        "value": "false",
                        "label": "Plain Text"
                      },
                      {
                        "value": "true",
                        "label": "HTML"
                      }
                    ]
                  },
                  {
                    "key": "body",
                    "type": "textarea",
                    "label": "Body Template"
                  }
                ]
              }
            ],
            "actions": [
              {
                "label": "Test Connection",
                "endpoint": "/extensions/mock-smtp/webadmin/actions/test-connection",
                "method": "POST",
                "confirm": "Send a test connection request to the configured SMTP server?"
              }
            ]
          }
        ],
        "settingsPanels": [
          {
            "tabKey": "mock-smtp",
            "tabLabel": "Mock SMTP",
            "sections": [
              {
                "title": "Global SMTP Defaults",
                "fields": [
                  {
                    "key": "defaultFrom",
                    "type": "text",
                    "label": "Default From Address",
                    "defaultValue": "noreply@example.com"
                  },
                  {
                    "key": "auditEnabled",
                    "type": "checkbox",
                    "label": "Audit Outbound Mail",
                    "defaultValue": "false"
                  },
                  {
                    "key": "retentionDays",
                    "type": "number",
                    "label": "Audit Retention (days)",
                    "defaultValue": "30",
                    "enabledWhen": {
                      "field": "auditEnabled",
                      "op": "truthy"
                    },
                    "validation": [
                      {
                        "rule": "min",
                        "value": 1
                      },
                      {
                        "rule": "max",
                        "value": 365
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "Mock Syslog Mode",
      "path": "mock-syslog-mode",
      "version": "1.0.0",
      "manifest": {
        "manifestVersion": 2,
        "transmissionModes": [
          {
            "name": "MockSyslog",
            "displayName": "Mock Syslog",
            "propertiesClass": "com.innovarhealthcare.connect.plugins.mocksyslogmode.MockSyslogModeProperties",
            "defaultStartBytes": "",
            "defaultEndBytes": "0A",
            "fields": [
              {
                "key": "framingMethod",
                "type": "select",
                "label": "Framing Method",
                "defaultValue": "nonTransparent",
                "options": [
                  {
                    "value": "nonTransparent",
                    "label": "Non-Transparent (trailer byte)"
                  },
                  {
                    "value": "octetCounting",
                    "label": "Octet Counting"
                  }
                ]
              },
              {
                "key": "maxMessageLength",
                "type": "number",
                "label": "Max Message Length",
                "defaultValue": "2048",
                "visibleWhen": {
                  "field": "framingMethod",
                  "op": "eq",
                  "value": "octetCounting"
                },
                "validation": [
                  {
                    "rule": "min",
                    "value": 480,
                    "message": "Syslog messages must allow at least 480 octets."
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "Mock DIMSE Data Type",
      "path": "mock-dimse-datatype",
      "version": "1.0.0",
      "manifest": {
        "manifestVersion": 2,
        "dataTypes": [
          {
            "name": "MockDIMSE",
            "displayName": "Mock DIMSE",
            "isBinary": true,
            "defaultAttachmentHandler": "com.mirth.connect.server.attachments.dicom.DICOMAttachmentHandlerProvider",
            "propertyGroups": [
              {
                "group": "serialization",
                "fields": [
                  {
                    "key": "transferSyntax",
                    "type": "select",
                    "label": "Transfer Syntax",
                    "tooltip": "DICOM transfer syntax expected on inbound associations.",
                    "options": [
                      {
                        "value": "implicitLittleEndian",
                        "label": "Implicit VR Little Endian"
                      },
                      {
                        "value": "explicitLittleEndian",
                        "label": "Explicit VR Little Endian"
                      }
                    ]
                  },
                  {
                    "key": "decodePixelData",
                    "type": "checkbox",
                    "label": "Decode Pixel Data",
                    "tooltip": "Decode the PixelData element when converting to XML."
                  },
                  {
                    "key": "maxPduLength",
                    "type": "number",
                    "label": "Max PDU Length",
                    "tooltip": "Maximum protocol data unit length in bytes.",
                    "visibleWhen": {
                      "field": "decodePixelData",
                      "op": "truthy"
                    },
                    "validation": [
                      {
                        "rule": "min",
                        "value": 1024
                      }
                    ]
                  }
                ]
              },
              {
                "group": "batch",
                "fields": [
                  {
                    "key": "splitType",
                    "type": "select",
                    "label": "Split Batch By",
                    "tooltip": "Select the method for splitting the batch message. This option has no effect unless Process Batch is enabled in the connector.",
                    "options": [
                      {
                        "value": "Association",
                        "label": "Association"
                      },
                      {
                        "value": "JavaScript",
                        "label": "JavaScript"
                      }
                    ]
                  },
                  {
                    "key": "batchScript",
                    "type": "javascript",
                    "label": "JavaScript",
                    "tooltip": "Enter JavaScript that splits the batch, and returns the next message. This script has access to 'reader', a Java BufferedReader, to read the incoming data stream.",
                    "visibleWhen": {
                      "field": "splitType",
                      "op": "eq",
                      "value": "JavaScript"
                    }
                  }
                ]
              },
              {
                "group": "responseValidation",
                "fields": [
                  {
                    "key": "successOnAccept",
                    "type": "checkbox",
                    "label": "Successful on C-STORE Accept",
                    "tooltip": "Treat an accepted C-STORE response as a successful message response."
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
